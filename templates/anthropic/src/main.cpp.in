// {{project.name}} — generated from {{self.name}}@{{self.version}}:anthropic
import mcpplibs.llmapi;
import std;

int main() {
    using namespace mcpplibs::llmapi;

    auto apiKey = std::getenv("ANTHROPIC_API_KEY");
    if (!apiKey) {
        std::println(std::cerr, "ANTHROPIC_API_KEY not set");
        return 1;
    }

    auto client = Client(AnthropicConfig{
        .apiKey = apiKey,
        .model = "claude-sonnet-4-20250514",
    });

    client.system("You are a concise assistant.");
    auto resp = client.chat("Say hello from {{project.name}} in one sentence.");

    std::println("{}", resp.text());
    return 0;
}
